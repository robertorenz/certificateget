<UserControl x:Class="CertificateGet.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Certificates" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Everything you have requested from Let's Encrypt, with all file formats kept ready to re-use." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="Refresh_Click" Margin="0,0,8,0" ToolTip="Reload from disk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                        <TextBlock Text="New certificate"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stat tiles -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,22,-6,18">
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="StatTotal" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="VALID" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="StatValid" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="StatSoonLabel" Text="EXPIRING SOON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="StatSoon" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="EXPIRED / NOT ISSUED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="StatExpired" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,12" TextChanged="Search_TextChanged"
                         ToolTip="Filter by name or domain"/>
                <Grid>
                    <ListBox x:Name="CertList" Style="{StaticResource CardList}" SelectionChanged="CertList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{Binding StatusLevel, Converter={StaticResource LevelBg}}" Margin="0,0,12,0">
                                        <TextBlock x:Name="Glyph" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16"
                                                   Foreground="{Binding StatusLevel, Converter={StaticResource LevelFg}}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DomainsDisplay}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                                Background="{Binding StatusLevel, Converter={StaticResource LevelBg}}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusLevel, Converter={StaticResource LevelFg}}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                            <TextBlock x:Name="WildTag" Text="WILDCARD" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" Visibility="Collapsed"/>
                                            <TextBlock Text="{Binding EnvironmentDisplay}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Environment, Converter={StaticResource LevelFg}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWildcard}" Value="True">
                                        <Setter TargetName="WildTag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="EmptyList" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No certificates yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Request your first one — start with Staging to test your setup." Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="New certificate" Style="{StaticResource PrimaryButton}" Click="New_Click" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- Details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border x:Name="NoSelection" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28">
                        <TextBlock Text="Select a certificate to see its files, history and actions." Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="DName" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="DDomains" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="5" Padding="8,3" Margin="0,0,6,6">
                                                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="#1E40AF"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border x:Name="DStatusBadge" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock x:Name="DStatusText" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Click="Renew_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="RenewText" Text="Renew"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportBtn" Click="Export_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                            <TextBlock Text="Export…"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="InstallBtn" Click="Install_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                            <TextBlock Text="Install in Windows"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenFolder_Click" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                            <TextBlock Text="Open folder"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Delete_Click" Margin="0,0,8,8" Foreground="{StaticResource DangerBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,7,0"/>
                                            <TextBlock Text="Delete"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,14"/>

                                <Grid x:Name="InfoGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Files (latest issuance)" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="NoFiles" Text="This certificate has not been issued yet — click Renew to request it." Style="{StaticResource Hint}" Visibility="Collapsed"/>
                                <ItemsControl x:Name="FilesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="46" Height="30" CornerRadius="5" Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Ext}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Click="FileShow_Click" ToolTip="Show in Explorer">
                                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Click="FileCopy_Click" ToolTip="Copy full path">
                                                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PfxPwdHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                <Button x:Name="ShowPwdBtn" Content="Show PFX password" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Foreground="{StaticResource PrimaryBrush}" Click="ShowPwd_Click" Margin="-6,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Issuance history" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5">
                                                            <Run Text="Issued" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding IssuedDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="  ·  valid" Foreground="{StaticResource TextMutedBrush}"/>
                                                            <Run Text="{Binding ValidDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Thumbprint}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Click="HistoryOpen_Click" ToolTip="Open this issuance's folder">
                                                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Click="HistoryExport_Click" ToolTip="Export this issuance">
                                                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
