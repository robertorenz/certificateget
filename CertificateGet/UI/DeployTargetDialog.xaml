<Window x:Class="CertificateGet.UI.DeployTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Width="760" SizeToContent="Height"
        FontFamily="Segoe UI">
    <Border Margin="24" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="24,22,24,10">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Deployment target" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TypeAgent" Content="CertificateGet Agent" Style="{StaticResource PillChoice}" GroupName="dtype" IsChecked="True" Checked="Type_Changed"/>
                        <RadioButton x:Name="TypeSftp" Content="SFTP / SSH" Style="{StaticResource PillChoice}" GroupName="dtype" Checked="Type_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,0,24,16">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,4,0,5"/>
                    <TextBox x:Name="NameBox" Tag="e.g. NetTalk server 1, HAProxy edge"/>

                    <!-- ===== Agent ===== -->
                    <StackPanel x:Name="AgentPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Agent URL" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AgentUrlBox" Tag="https://server-name:9443" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="API key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ApiKeyBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Slot on the agent" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SlotBox" Tag="name of the slot in the agent's agent.json" FontFamily="{StaticResource MonoFont}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Click="TestAgent_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Connect &amp; list slots"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="SlotChips" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="SlotChip_Click" Margin="0,0,6,6" Padding="10,4" ToolTip="{Binding Tip}">
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"/>
                                            <Run Text="{Binding Count, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontWeight="Normal"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="The agent decides where the files go: each slot in its agent.json lists one or more destinations (folders, file names, services to restart, TSplus import)."/>
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="AgentFpText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
                            <Button x:Name="ForgetAgentFp" Content="Forget fingerprint" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Right" Click="ForgetAgentFp_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== SFTP ===== -->
                    <StackPanel x:Name="SftpPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="HostBox" Tag="server.example.com" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PortBox" Text="22"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="UserBox" Tag="root"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="AuthPassword" Content="Password" GroupName="auth" IsChecked="True" Margin="0,0,20,0" Checked="Auth_Changed"/>
                            <RadioButton x:Name="AuthKey" Content="Private key file" GroupName="auth" Checked="Auth_Changed"/>
                        </StackPanel>
                        <PasswordBox x:Name="SshPasswordBox" Margin="0,8,0,0"/>
                        <Grid x:Name="KeyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="KeyPathBox" Tag="C:\Users\me\.ssh\id_ed25519"/>
                            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseKey_Click"/>
                            <PasswordBox x:Name="KeyPassBox" Grid.Column="3" ToolTip="Key passphrase (leave empty if none)"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Remote folder" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="Preset:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="HAProxy" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBrush}" Click="PresetHaproxy_Click"/>
                                <Button Content="nginx" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBrush}" Click="PresetNginx_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="RemoteFolderBox" Tag="/etc/haproxy/certs" FontFamily="{StaticResource MonoFont}"/>

                        <TextBlock Text="Files to upload" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl x:Name="FilesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"/>
                                        <TextBlock Grid.Column="1" Text="→" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox Grid.Column="2" Text="{Binding RemoteName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="RemoveFile_Click" ToolTip="Remove">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add file" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Click="AddFile_Click" Margin="-6,0,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{}{domain} = main domain as a file name (e.g. wildcard.example.com), {name} = the certificate's display name. Files are uploaded under a temporary name and swapped in atomically; key files get mode 600."/>

                        <TextBlock Text="Command to run afterwards (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PostCommandBox" FontFamily="{StaticResource MonoFont}" Tag="haproxy -c -f /etc/haproxy/haproxy.cfg &amp;&amp; systemctl reload haproxy"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Runs over SSH as the same user. The deployment fails if it exits with a non-zero code."/>

                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="HostFpText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ForgetHostFp" Content="Forget host key" Style="{StaticResource GhostButton}" Foreground="{StaticResource PrimaryBrush}" Click="ForgetHostFp_Click"/>
                                <Button Margin="8,0,0,0" Click="TestSftp_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Test connection"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="EnabledBox" Content="Enabled" IsChecked="True" Margin="0,0,24,0"/>
                        <CheckBox x:Name="AutoBox" Content="Deploy automatically after every issuance / renewal" IsChecked="True"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource CardAltBrush}" CornerRadius="0,0,12,12" Padding="20,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Save target" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
