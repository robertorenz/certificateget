<Window x:Class="CertificateGet.UI.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="640"
        FontFamily="Segoe UI">
    <Border Margin="24" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="24,22,24,18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Export certificate" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Destination folder" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>

                <TextBlock Text="Formats" Style="{StaticResource FieldLabel}"/>
                <ItemsControl x:Name="FormatsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected}" Margin="0,4,12,4" ToolTip="{Binding Description}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PFX password" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="UseStoredPwd" Content="Use the stored password" GroupName="pwd" IsChecked="True" Margin="0,0,20,0" Checked="PwdMode_Changed"/>
                    <RadioButton x:Name="UseNewPwd" Content="Set a new password" GroupName="pwd" Checked="PwdMode_Changed"/>
                </StackPanel>
                <PasswordBox x:Name="NewPwd" Margin="0,8,0,0" IsEnabled="False"/>
                <TextBlock Style="{StaticResource Hint}" Text="Leave the new password empty to export a PFX without a password (some services require that)."/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource CardAltBrush}" CornerRadius="0,0,12,12" Padding="20,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Export files" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Export_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
