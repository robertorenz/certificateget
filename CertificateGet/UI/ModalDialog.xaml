<Window x:Class="CertificateGet.UI.ModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI">
    <Border Margin="24" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Width="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="24,24,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconCircle" Width="42" Height="42" CornerRadius="21" VerticalAlignment="Top" Margin="0,0,16,0">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                 TextWrapping="Wrap" FontSize="13" Foreground="#334155">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource CardAltBrush}" CornerRadius="0,0,12,12" Padding="20,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
