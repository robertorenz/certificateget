<Window x:Class="CertificateGet.UI.DnsRecordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="780"
        FontFamily="Segoe UI">
    <Border Margin="24" Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="24,22,24,8">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Create these DNS TXT records" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Add them at your DNS provider, wait for them to propagate, then continue." Style="{StaticResource PageSubtitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E">
                        When two rows share the same record name (for example a wildcard plus the bare domain) you must create
                        <Bold>both</Bold> TXT values under that name — do not replace one with the other. Use a low TTL (60–300 s) if your provider allows it.
                    </TextBlock>
                </Border>
            </StackPanel>

            <ItemsControl x:Name="RecordsList" Grid.Row="1" Margin="24,8,24,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="For" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Domain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="Badge" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" Background="#F1F5F9">
                                        <TextBlock x:Name="BadgeText" Text="{Binding FoundDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="Name (host)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordName, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" Margin="0,8,8,0"/>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                        Click="CopyName_Click" ToolTip="Copy name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Row="2" Text="TXT value" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" Margin="0,8,8,0"/>
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                        Click="CopyValue_Click" ToolTip="Copy value">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Found}" Value="True">
                                <Setter TargetName="Badge" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#15803D"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="{StaticResource CardAltBrush}" CornerRadius="0,0,12,12" Padding="20,14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CheckButton" Click="Check_Click" Style="{StaticResource SecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                <TextBlock Text="Check DNS now"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CheckStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True"/>
                        <Button Content="Continue validation" Click="Continue_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
