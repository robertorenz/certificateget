<Window x:Class="CertificateGet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="CertificateGet — Let's Encrypt and ZeroSSL certificate manager"
        Width="1280" Height="820" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,16,26">
                    <Border Width="38" Height="38" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#0D9488" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CertificateGet" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Let's Encrypt · ZeroSSL" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="12,10" CornerRadius="8" Background="#16213A">
                    <StackPanel>
                        <TextBlock Text="STORE" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StorePathText" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,6"/>
                        <Button Content="Open store folder" Click="OpenStore_Click" FontSize="11" Padding="8,4"
                                Background="#1E293B" BorderBrush="#334155" Foreground="{StaticResource SidebarTextBrush}" Tag="#334155"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="MANAGE" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="24,0,0,6"/>
                    <RadioButton x:Name="NavCerts" Style="{StaticResource NavItem}" Tag="&#xE8FD;" Content="Certificates" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavNew" Style="{StaticResource NavItem}" Tag="&#xE710;" Content="New certificate" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Activity log" GroupName="nav" Checked="Nav_Checked"/>
                    <TextBlock Text="SYSTEM" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="24,18,0,6"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" GroupName="nav" Checked="Nav_Checked"/>
                    <Button Style="{StaticResource NavAction}" Tag="&#xE897;" Content="Help" Click="Help_Click" ToolTip="Manual: the app and the agent, in English or Spanish (F1)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="PageHost" Grid.Column="1"/>

        <!-- Dim layer shown behind modal popups -->
        <Border x:Name="DimLayer" Grid.ColumnSpan="2" Background="#660F172A" Visibility="Collapsed"/>
    </Grid>
</Window>
